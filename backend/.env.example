PORT=4000

# Cadena de conexión a MongoDB (Mongo_Dev_Environment vía docker-compose.yml).
# El usuario/contraseña deben coincidir con MONGO_INITDB_ROOT_USERNAME / MONGO_INITDB_ROOT_PASSWORD
# definidos en docker-compose.yml. authSource=admin es obligatorio porque el usuario
# se crea contra la base "admin" (usuario root de MongoDB).
MONGO_URI=mongodb://liga:liga_dev_password@localhost:27017/liga_da_tutti?authSource=admin


JWT_SECRET=liga-da-tutti-dev-secret-change-me

JWT_EXPIRES_IN=1d

# CORS:  Frontend_App corriendo en el puerto default de Vite
CORS_ORIGIN=http://localhost:5173
